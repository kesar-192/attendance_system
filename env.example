# Copy to .env and fill in. Used by docker-compose.yml.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- MongoDB (use letters and digits only, or URL-encode special characters)
MONGO_ROOT_USERNAME=campusflow
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password
MONGO_DB=campusflow

# ---- API secrets (32+ characters each, and different from each other)
JWT_SECRET=
QR_SECRET=
JWT_EXPIRES_IN=8h

# ---- Public URL of the web app (CORS allow-list, comma separated, no trailing slash)
CORS_ORIGIN=https://attendance.example.edu
WEB_PORT=80

# ---- Attendance rules
ATTENDANCE_THRESHOLD=75
ATTENDANCE_TZ=Asia/Kolkata
QR_ROTATE_SECONDS=30

# ---- Rate limiting
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- First administrator (docker compose --profile tools run --rm seed)
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
